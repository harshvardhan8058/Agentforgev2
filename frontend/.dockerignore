# Frontend_Image build-context exclusions (deployment Req 2.5, 3.2, 3.3, 10.2, 10.3).
#
# Keep the build context small and free of dev artifacts and credentials so nothing
# unnecessary or sensitive is sent to the image builder or ends up in any layer. The
# multi-stage build runs `npm ci` + `npm run build` from source, so committed build
# output and installed dependencies must NOT be shipped into the context.

# Installed dependencies (reinstalled with `npm ci` inside the build stage).
node_modules/

# Build output (regenerated by `npm run build` inside the build stage).
dist/
dist-ssr/

# Vite / test / coverage caches and reports.
.vite/
coverage/
*.local

# Local environment files — never copy a credential into the image (only
# *.env.example placeholders are ever committed, and those are not needed at build).
.env
.env.*
!.env.example

# Version control and editor/OS noise.
.git
.gitignore
.DS_Store

# The Dockerfile and this ignore file themselves are not needed inside the context.
Dockerfile
.dockerignore
