# AgentForge Web_Client configuration.
#
# ONLY non-secret configuration belongs here. No credentials, tokens, or API
# keys are ever read by the client or embedded in the compiled bundle — the
# frontend talks only to the Backend_API and obtains its Access_Token at runtime
# via the login flow.

# Base URL of the AgentForge Backend_API (required).
VITE_API_BASE_URL=http://localhost:8000
