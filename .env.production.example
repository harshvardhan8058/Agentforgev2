# AgentForge — PRODUCTION environment template (Phase 9, Req 9.2, 9.4, 10.3).
#
# Copy to `.env` on the deployment host and fill in REAL values there. Docker Compose
# auto-reads `.env` for ${VAR} interpolation in docker-compose.production.yml. This file
# enumerates EVERY production setting with PLACEHOLDER values only and contains NO real
# credential (Req 10.3). Never commit the filled-in `.env`.
#
# Apply the overlay with:
#   docker compose -f docker-compose.yml -f docker-compose.production.yml pull
#   docker compose -f docker-compose.yml -f docker-compose.production.yml up -d
#
# Required vs optional per setting is documented, by name and by profile, in
# docs/CONFIGURATION.md. In production the REQUIRED settings are DATABASE_URL, REDIS_URL
# (required non-secret DSNs) and JWT_SECRET (the required SecretStr); startup aborts naming
# the missing key if any is absent. Every provider/integration credential below is OPTIONAL
# and feature-gated (blank = that capability stays disabled, no outbound call).

# --- profile ---
# Must be `production` so the app enforces the JWT_SECRET guard and disables dev fallbacks.
PROFILE=production

# --- domain-store persistence (non-secret) ---
# Persist the ten Domain_Stores to Postgres. Implied by PROFILE=production; set explicitly
# here for clarity. See docs/CONFIGURATION.md.
USE_DATABASE=true

# --- image selection (three-tag GHCR strategy) ---
# Pin an IMMUTABLE tag (a git SHA like 9f3c1a2... or a semver like v1.4.2) for reproducible
# deploys and instant rollback. `latest` is convenient but never used to pin a rollback.
AGENTFORGE_IMAGE_TAG=latest

# --- required infrastructure DSNs (non-secret shape, but host-specific) ---
# Async SQLAlchemy DSN. User/password/db MUST match the POSTGRES_* values below.
DATABASE_URL=postgresql+asyncpg://REPLACE_USER:REPLACE_PASSWORD@postgres:5432/REPLACE_DB
REDIS_URL=redis://redis:6379/0

# --- required secret ---
# Access-token signing secret. REQUIRED in production — the app aborts on boot if missing.
# Generate a long random value, e.g. `openssl rand -hex 32`.
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

# --- postgres container credentials (non-default, Req 5.3) ---
POSTGRES_USER=REPLACE_USER
POSTGRES_PASSWORD=REPLACE_PASSWORD
POSTGRES_DB=REPLACE_DB

# --- embeddings ---
# Must match the dimension the migrations sized the vector column to.
EMBEDDING_DIMENSION=384

# --- frontend Runtime_Config ---
# The SPA's API base URL, resolved at container start. Use a same-origin path served
# through the proxy (e.g. `/`) or an absolute HTTPS origin (e.g. https://your-host).
API_BASE_URL=https://REPLACE_HOST

# --- TLS material (mounted read-only into the proxy; never baked into an image) ---
# Host paths to the certificate chain and private key.
TLS_CERT_PATH=/etc/letsencrypt/live/REPLACE_HOST/fullchain.pem
TLS_KEY_PATH=/etc/letsencrypt/live/REPLACE_HOST/privkey.pem

# --- cost governance ---
# How long a computed month-to-date spend is reused before recomputing (the budget check runs
# in front of every agent/RAG request). Bounded overshoot within the window is the trade.
BUDGET_CACHE_SECONDS=30

# --- audit trail ---
# false (default) = a failed audit write is logged at ERROR and the request still succeeds;
# true = the request fails, so no administrative action can happen unrecorded. Choose `true`
# if you are asked to prove the trail is complete (SOC 2, ISO 27001), `false` if availability
# of the admin surface matters more than completeness of its trail.
AUDIT_LOG_REQUIRED=false

# --- optional provider credentials (leave blank to keep that capability keyless) ---
# Provide a Groq API key to activate the Groq LLM provider (else deterministic fallback).
GROQ_API_KEY=
# Model the Groq provider requests; blank keeps the provider's default
# (llama-3.1-8b-instant). Any model named here should also be priced by the cost settings
# below, or its usage falls back to the default rate.
GROQ_MODEL=
# Provide a hosted embedding API key only when using a hosted embedding provider.
HOSTED_EMBEDDING_API_KEY=
# Provide a web-search API key to activate the Web_Search_Tool (else disabled).
SEARCH_API_KEY=
# Provide a LangSmith API key to activate the trace exporter (else keyless NoOp exporter).
LANGSMITH_API_KEY=
# --- trace export destination (optional; exactly one is active) ---
# Traces are always recorded locally; these decide whether a finished run is ALSO forwarded
# somewhere. LANGSMITH_API_KEY above takes precedence; an OTLP endpoint is used when it is
# blank. Requires the optional extra in the image (`pip install ".[otel]"`); without it the
# exporter degrades to no export instead of failing runs. Verify after deploying with
# `GET /observability/status`.
OTEL_EXPORTER_ENDPOINT=
OTEL_SERVICE_NAME=agentforge
# Optional OTLP headers ("k=v,k2=v2"); an ingest key belongs here and is never logged.
OTEL_HEADERS=


# --- cost model (optional; costs report as 0 until something here prices tokens) ---
# Pricing resolves default rates -> named preset -> explicit per-model table, with later
# stages overriding earlier ones per (provider, model) pair. A production deployment that
# sets GROQ_API_KEY above but nothing here will record real token usage at zero cost, so
# the analytics dashboards will read $0.00 for every run.
#
# A named preset of the vendor's published per-model list prices, shipped with the
# platform (src/agentforge/observability/cost_presets.py). Rates are indicative and dated;
# override individual pairs below if you hold negotiated or batch-discounted rates. An
# unknown name aborts startup naming the setting.
# Known presets: groq-public-2026-07
COST_RATE_PRESET=
# Explicit per-1K rate table keyed by "provider:model" (Decimal-as-string, no floats),
# e.g. {"groq:llama-3.1-8b-instant": {"prompt": "0.00005", "completion": "0.00008"}}.
COST_RATE_TABLE_JSON=
# Fallback rates for any pair the preset/table do not list. Leave at 0 unless you want
# unlisted models charged at a nominal rate.
COST_DEFAULT_PROMPT_PER_1K=0.0
COST_DEFAULT_COMPLETION_PER_1K=0.0
# Verify the result after deploying: GET /analytics/cost-rates reports the effective
# preset, per-model rates, and whether the deployment prices anything at all.
