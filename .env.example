# AgentForge environment configuration example.
# Copy to `.env` and adjust. This file lists EVERY setting with placeholder
# values and contains NO real credentials (Req 3.5).

# --- profile / server ---
# local (default, keyless: Chroma + local embeddings + fallback LLM) or production.
PROFILE=local
API_PORT=8000

# --- chunking ---
CHUNK_MAX_CHARS=1000
CHUNK_OVERLAP_CHARS=150
# strip (normalize Markdown to plain text) or preserve (keep raw Markdown).
MARKDOWN_MODE=strip

# --- embeddings ---
# sentence_transformer (default local, no key) or hosted.
EMBEDDING_PROVIDER=sentence_transformer
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# --- retrieval ---
TOP_K_DEFAULT=4
TOP_K_MIN=1
TOP_K_MAX=10

# --- ingestion limits ---
MAX_DOCUMENT_BYTES=52428800
EXTRACTION_TIMEOUT_SECONDS=30

# --- agentic layer (Phase 3; all optional, keyless-safe) ---
# Max reason->act->observe cycles per agent run. Resolved into [1, 100]; leave blank
# for the bounded default of 10.
ITERATION_LIMIT=
# Short-term memory size budget (positive token/character count). Leave blank to skip
# short-term memory maintenance.
MEMORY_SIZE_BUDGET=
# Web-search provider: disabled (default, keyless) or tavily.
SEARCH_PROVIDER=disabled

# --- multi-agent layer (Phase 4; all optional, keyless-safe) ---
# Max collaboration rounds per multi-agent run. Resolved into [1, 50]; leave blank for
# the bounded default of 6.
MAX_ROUNDS=
# Max Critic-driven revision cycles per multi-agent run. Resolved into [1, 20]; leave
# blank for the bounded default of 3.
MAX_REVISIONS=
# Human approval policy: auto (default, keyless auto-approve) or human (human-in-the-loop).
APPROVAL_POLICY=auto

# --- enterprise layer (Phase 5; all optional, keyless-safe) ---
# Master toggle for the auth/RBAC/tenancy layer. Leave true; the test suite may disable it.
AUTH_ENABLED=true
# Access token signing secret. OPTIONAL in local (a per-boot dev secret is generated when
# blank); REQUIRED in the production profile (boot aborts if missing). Leave blank locally.
# JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRY_SECONDS=3600
# argon2id password / API-key hashing parameters (sensible defaults; tune per environment).
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=2
# Per-principal rate limiting (Redis-backed). Set false for deterministic tests / keyless.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_SECONDS=60

# --- observability layer (Phase 6; all optional, keyless-safe) ---
# LangSmith project name used when trace export is active.
LANGSMITH_PROJECT=agentforge
# Master toggle for trace export. Even when true, the keyless NoOp exporter is used
# until a LANGSMITH_API_KEY is provided (below), so no external call is ever made
# without a credential.
TRACING_EXPORT_ENABLED=true
# --- cost model -----------------------------------------------------------------
# Pricing resolves lowest-to-highest precedence: default rates -> named preset ->
# explicit per-model table. Everything below is optional; with none of it set the
# platform prices every call at 0, which is correct for the keyless stack (the local
# Fallback provider costs nothing) but means the analytics dashboards report $0.00.
#
# Applied to any (provider, model) the preset/table below do not list
# (Decimal-as-string, so no float drift). The keyless default is free.
COST_DEFAULT_PROMPT_PER_1K=0.0
COST_DEFAULT_COMPLETION_PER_1K=0.0
# Optional named preset of published per-model rates shipped with the platform
# (src/agentforge/observability/cost_presets.py). Set this and a deployment holding a
# GROQ_API_KEY reports real costs with no further configuration. Rates are the vendor's
# public list prices at the date in the name and are indicative only - override any pair
# below. An unknown name aborts startup rather than silently unpricing the deployment.
# Known presets: groq-public-2026-07
# COST_RATE_PRESET=groq-public-2026-07
# Optional JSON per-1K rate table keyed by "provider:model", e.g.
# {"groq:llama-3.1-8b-instant": {"prompt": "0.00005", "completion": "0.00008"}}.
# Entries here override the preset for the same pair. Leave blank for defaults.
# COST_RATE_TABLE_JSON=
# GET /analytics/cost-rates reports the effective result of all three settings.
# Default max-length input guardrail (characters).
GUARDRAIL_MAX_INPUT_CHARS=8000
# Optional static blocklist terms as a JSON array, e.g. ["term-a", "term-b"]. Leave blank
# to disable the blocklist guardrail.
# GUARDRAIL_BLOCKLIST_JSON=

# --- infrastructure (REQUIRED non-secret settings) ---
# Async SQLAlchemy DSN. Within docker compose the host is the `postgres` service.
DATABASE_URL=postgresql+asyncpg://agentforge:agentforge@postgres:5432/agentforge
REDIS_URL=redis://redis:6379/0

# --- credentials (ALL OPTIONAL; leave blank to run keyless) ---
# Provide a Groq API key to activate the Groq LLM provider. Leave blank for the
# deterministic Fallback provider.
GROQ_API_KEY=
# Provide a hosted embedding API key only when EMBEDDING_PROVIDER=hosted.
HOSTED_EMBEDDING_API_KEY=
# Provide a web-search API key to activate the Web_Search_Tool. Leave blank to keep
# web search disabled (no external network request).
SEARCH_API_KEY=
# Provide a LangSmith API key (the Tracing_Credential) to activate the LangSmith trace
# exporter. Leave blank for the keyless NoOp exporter (no external call).
# LANGSMITH_API_KEY=

# --- third-party integrations (Phase 8; all optional, keyless-safe) ---
# Each integration is a pluggable Tool DISABLED by default. Provide the matching token to
# enable it; leave blank (the default) to keep it Disabled with no outbound network call.
# The platform runs and tests with zero integration credentials.
# Slack bot token (enables the Slack tool: read_channel / post_message).
# SLACK_BOT_TOKEN=
# Gmail token (enables the Gmail tool: search_messages / read_message / send_message).
# GMAIL_TOKEN=
# Google Drive token (enables the read-only Google Drive tool: list / search / read).
# GOOGLE_DRIVE_TOKEN=
# GitHub token (enables the GitHub tool: search_code / search_issues / read_repo / create_issue).
# GITHUB_TOKEN=
# Per-integration enable toggles (non-secret). Default true; set false to hold an
# integration Disabled even when its token is present.
SLACK_ENABLED=true
GMAIL_ENABLED=true
GOOGLE_DRIVE_ENABLED=true
GITHUB_ENABLED=true
# Bounded, keyless-safe execution limits shared by every integration tool.
# Timeout_Budget (seconds) for a single integration invocation.
INTEGRATION_TIMEOUT_SECONDS=10
# Maximum number of results a single integration invocation may return.
INTEGRATION_MAX_RESULTS=20
