# AgentForge environment configuration example.
# Copy to `.env` and adjust. This file lists EVERY setting with placeholder
# values and contains NO real credentials (Req 3.5).

# --- profile / server ---
# local (default, keyless: Chroma + local embeddings + fallback LLM) or production.
PROFILE=local
API_PORT=8000

# --- chunking ---
CHUNK_MAX_CHARS=1000
CHUNK_OVERLAP_CHARS=150
# strip (normalize Markdown to plain text) or preserve (keep raw Markdown).
MARKDOWN_MODE=strip

# --- embeddings ---
# sentence_transformer (default local, no key) or hosted.
EMBEDDING_PROVIDER=sentence_transformer
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# --- retrieval ---
TOP_K_DEFAULT=4
TOP_K_MIN=1
TOP_K_MAX=10

# --- ingestion limits ---
MAX_DOCUMENT_BYTES=52428800
EXTRACTION_TIMEOUT_SECONDS=30

# --- agentic layer (Phase 3; all optional, keyless-safe) ---
# Max reason->act->observe cycles per agent run. Resolved into [1, 100]; leave blank
# for the bounded default of 10.
ITERATION_LIMIT=
# Short-term memory size budget (positive token/character count). Leave blank to skip
# short-term memory maintenance.
MEMORY_SIZE_BUDGET=
# Web-search provider: disabled (default, keyless) or tavily.
SEARCH_PROVIDER=disabled

# --- infrastructure (REQUIRED non-secret settings) ---
# Async SQLAlchemy DSN. Within docker compose the host is the `postgres` service.
DATABASE_URL=postgresql+asyncpg://agentforge:agentforge@postgres:5432/agentforge
REDIS_URL=redis://redis:6379/0

# --- credentials (ALL OPTIONAL; leave blank to run keyless) ---
# Provide a Groq API key to activate the Groq LLM provider. Leave blank for the
# deterministic Fallback provider.
GROQ_API_KEY=
# Provide a hosted embedding API key only when EMBEDDING_PROVIDER=hosted.
HOSTED_EMBEDDING_API_KEY=
# Provide a web-search API key to activate the Web_Search_Tool. Leave blank to keep
# web search disabled (no external network request).
SEARCH_API_KEY=
